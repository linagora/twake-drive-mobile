{
  "expo": {
    "name": "Twake Drive",
    "slug": "twake-drive-mobile",
    "version": "0.14.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": ["twakedrive"],
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.linagora.twakedrive",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch", "processing"],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.linagora.twakedrive.backup.processing",
          "com.linagora.twakedrive.backup.refresh",
          "com.linagora.twakedrive.backup.continued.*"
        ]
      },
      "associatedDomains": ["applinks:links.twake.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.linagora.twakedrive",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.twake.app",
              "pathPrefix": "/drive"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-asset",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withTwakeDocumentsProvider",
      "./plugins/withTwakeShareIntent",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.linagora.com/",
          "organization": "linagora",
          "project": "twake-drive-mobile"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#15171A"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "playIntegrityCloudProjectNumber": "1028177561827"
    }
  }
}
