# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# signing / release secrets (values must never be committed)
.release-secrets.env
*-release.keystore
/android/app/release.keystore
gcp-service-account*.json

# typescript
*.tsbuildinfo

# native build outputs (the ios/ and android/ projects themselves are tracked)
/build
/ios/Pods
/ios/build
/android/build
/android/.gradle
/android/app/build
/android/local.properties
.claude/
.superpowers/

# Internal docs — design specs, implementation plans, CI/release runbooks and
# TODOs are kept local; only the public end-to-end testing guide is tracked.
/docs/*
!/docs/e2e-testing.md

# Built by scripts/build-excalidraw.mjs from the pinned @excalidraw/excalidraw
assets/webviewer/
