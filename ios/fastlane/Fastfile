require "json"

default_platform(:ios)

# Twake Drive iOS release lanes. Signing uses fastlane match (App Store
# distribution certs + profiles stored, encrypted, in a shared git repo — the
# SAME repo/cert as visio-mobile since both live under Apple team KUT463DS29;
# twake's profiles are seeded once with `fastlane match appstore`). CI never
# generates certs (readonly: true). See docs/ci-cd-signed-release.md.
APP_IDENTIFIER = "com.linagora.twakedrive"

# The version being released: the tag the release workflow passes, and the one
# the app displays otherwise, which app.json owns — the same fallback
# android/app/build.gradle applies, so a manual run does not ship the version
# left in the Xcode project.
def marketing_version
  from_env = ENV["MARKETING_VERSION"].to_s
  return from_env unless from_env.empty?

  JSON.parse(File.read(File.expand_path("../../app.json", __dir__)))["expo"]["version"].to_s
end

platform :ios do
  # One-off provisioning: create any MISSING match profiles (e.g. a newly-added
  # extension) in WRITE mode, so the readonly release lane can then fetch them.
  # `force: false` reuses the existing app/ShareExt profiles and only creates the
  # missing one. PREREQUISITE: the App ID must already carry its capabilities
  # (App Groups) in the Apple Developer portal — match provisions profiles, it
  # does NOT enable capabilities. Run via the provision-ios workflow.
  desc "Create missing match profiles for the app + extensions (write mode)"
  lane :provision_extensions do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER, "#{APP_IDENTIFIER}.ShareExt", "#{APP_IDENTIFIER}.FileProvider"],
      git_url: ENV["MATCH_GIT_URL"],
      api_key: api_key,
      readonly: false,
      force: false
    )
  end

  desc "Build a signed IPA and upload it to TestFlight"
  lane :distribute do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      # Fetch ALL profiles (app + Share Extension + File Provider Extension) so the
      # archive can sign each target with its own match profile.
      app_identifier: [APP_IDENTIFIER, "#{APP_IDENTIFIER}.ShareExt", "#{APP_IDENTIFIER}.FileProvider"],
      git_url: ENV["MATCH_GIT_URL"],
      api_key: api_key,
      readonly: true
    )

    # Marketing version comes from the git tag (vX.Y.Z -> X.Y.Z) or, without one,
    # from app.json; build number from the monotonic CI run number. agvtool needs
    # the project on "Apple Generic" versioning (Expo default); if it errors
    # "No values were found", set Versioning System = Apple Generic in Build
    # Settings (see runbook).
    increment_version_number(
      version_number: marketing_version,
      xcodeproj: "TwakeDrive.xcodeproj"
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1",
      xcodeproj: "TwakeDrive.xcodeproj"
    )

    # Expo/RN app: build the WORKSPACE (Pods), not the bare project. Force manual
    # signing with the match-managed App Store profile.
    gym(
      scheme: "TwakeDrive",
      workspace: "TwakeDrive.xcworkspace",
      export_method: "app-store",
      output_directory: "build",
      output_name: "TwakeDrive.ipa",
      clean: true,
      # No global PROVISIONING_PROFILE_SPECIFIER — each target (app + ShareExt)
      # carries its own match profile in the pbxproj (scripts/ios-set-extension-signing.cjs),
      # so gym signs each with the right profile instead of forcing the app's onto the ext.
      xcargs: "DEVELOPMENT_TEAM='#{ENV["APPLE_TEAM_ID"]}' CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        teamID: ENV["APPLE_TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}",
          "#{APP_IDENTIFIER}.ShareExt" => "match AppStore #{APP_IDENTIFIER}.ShareExt",
          "#{APP_IDENTIFIER}.FileProvider" => "match AppStore #{APP_IDENTIFIER}.FileProvider"
        }
      }
    )

    # First validations: plain internal TestFlight upload — instant, no external
    # "Beta Testers" group or Beta App Review needed. Restore distribute_external +
    # groups once Test Info is filled and the first build cleared Beta review.
    pilot(
      api_key: api_key,
      ipa: "build/TwakeDrive.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push App Store metadata (binary already uploaded by :distribute)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      submit_for_review: false,
      force: true,
      skip_binary_upload: true,
      metadata_path: "./fastlane/metadata",
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
